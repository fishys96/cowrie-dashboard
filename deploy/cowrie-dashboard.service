# Install:
#   sudo cp deploy/cowrie-dashboard.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now cowrie-dashboard
#
# Logs:
#   journalctl -u cowrie-dashboard -f
#
# Permissions gotcha: cowrie.json is normally owned by the `cowrie` user. Grant the
# dashboard user read access, e.g.:
#   sudo usermod -aG cowrie dashboard
#   sudo chmod g+rx /home/cowrie/cowrie/var/log/cowrie
# (adjust group/paths to match your Cowrie install)

[Unit]
Description=Cowrie Attack Dashboard
After=network.target

[Service]
Type=simple
User=dashboard
Group=dashboard
WorkingDirectory=/opt/cowrie-dashboard
EnvironmentFile=/opt/cowrie-dashboard/.env
ExecStart=/opt/cowrie-dashboard/venv/bin/uvicorn backend.main:app --host 127.0.0.1 --port 8080
Restart=always
RestartSec=3

# Light sandboxing -- tune if your Cowrie log lives outside the default paths
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/cowrie-dashboard/data
ReadOnlyPaths=/var/log/cowrie

[Install]
WantedBy=multi-user.target

