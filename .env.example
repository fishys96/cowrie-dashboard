# Path to the Cowrie JSON event log (must be readable by the dashboard process)
COWRIE_LOG_PATH=/var/log/cowrie/cowrie.json

# MaxMind GeoLite2 databases (download from https://www.maxmind.com/en/geolite2/signup)
GEOIP_CITY_DB=./geoip/GeoLite2-City.mmdb
GEOIP_ASN_DB=./geoip/GeoLite2-ASN.mmdb

# Honeypot's approximate location, used as the arc destination on the globe.
# Set to your Azure VPS region's coordinates.
HONEYPOT_LAT=37.3719
HONEYPOT_LON=-79.8164
HONEYPOT_LABEL=Azure VPS (East US)

# Web server bind (leave as 127.0.0.1 to keep the dashboard reachable only via SSH tunnel)
HOST=127.0.0.1
PORT=8080

# SQLite database file (created automatically)
DB_PATH=./data/dashboard.db

# How many recent events to keep in the live feed buffer
FEED_LIMIT=200

# How often (seconds) the tailer polls the log file for new lines
POLL_INTERVAL=0.5

# How many hours of history the attack timeline chart covers
TIMELINE_HOURS=24

# On startup, replay events from SQLite (last TIMELINE_HOURS) to rebuild in-memory aggregates
REPLAY_ON_START=true
